    "test:update": "vitest -u",
    "test:clear": "vitest --clearCache",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky install && tsx src/scripts/init-msw.ts",
