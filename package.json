{
  "name": "mytodo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "mocha tests/**/*.test.js --timeout 10000",
    "migrate": "node scripts/migrate.js",
    "migrate:create": "node scripts/create-migration.js",
